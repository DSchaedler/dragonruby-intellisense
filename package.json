{
  "name": "dragonruby-intellisense",
  "displayName": "DragonRuby Intellisense",
  "description": "Ruby completions, snippets, hover descriptions, and signature help for DragonRuby GTK.",
  "publisher": "DeeSchaedler",
  "version": "0.0.1",
  "license": "MIT",
  "icon": "images/dragonruby-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DSchaedler/dragonruby-intellisense.git"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ruby"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dragonruby-intellisense.scanApi",
        "title": "DragonRuby: Scan Workspace for Missing API Calls"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
